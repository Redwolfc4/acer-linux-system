#!/usr/bin/env bash

# Acer Nitro & Predator Control Center + Developer Tools (CLI)
# Acer Linux System Control & Dev Suite

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_DIR="$(cd "$(dirname "$REAL_SCRIPT")/.." && pwd)"

if [ -f "$PROJECT_DIR/rgb/facer_rgb.py" ]; then
    FACER_RGB_SCRIPT="$PROJECT_DIR/rgb/facer_rgb.py"
    KEYBOARD_WIZARD_DIR="$PROJECT_DIR/rgb"
elif [ -f "/opt/turbo-fan/facer_rgb.py" ]; then
    FACER_RGB_SCRIPT="/opt/turbo-fan/facer_rgb.py"
    KEYBOARD_WIZARD_DIR="/opt/turbo-fan"
else
    FACER_RGB_SCRIPT="/usr/local/bin/facer_rgb.py"
    KEYBOARD_WIZARD_DIR="/opt/turbo-fan"
fi

CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
BLUE="\033[1;34m"
PURPLE="\033[1;35m"
BOLD="\033[1m"
RESET="\033[0m"

function is_in_git_repo() {
    git rev-parse --is-inside-work-tree &>/dev/null
}

function get_local_gh_token() {
    if is_in_git_repo; then
        local local_gh
        local_gh=$(git config --local github.user 2>/dev/null)
        if [ -n "$local_gh" ]; then
            gh auth token -u "$local_gh" 2>/dev/null
        fi
    fi
}

# Helper: Jalankan perintah sebagai user asli (bukan root) jika sudo
function run_as_user() {
    local local_token=""
    # Jangan override jika perintahnya berhubungan dengan manajemen auth gh
    if ! [[ "$*" =~ "gh auth" ]]; then
        local_token=$(get_local_gh_token)
    fi

    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
        local user_home
        user_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
        if [ -n "$local_token" ]; then
            sudo -u "$SUDO_USER" HOME="$user_home" GH_TOKEN="$local_token" "$@"
        else
            sudo -u "$SUDO_USER" HOME="$user_home" "$@"
        fi
    else
        if [ -n "$local_token" ]; then
            GH_TOKEN="$local_token" "$@"
        else
            "$@"
        fi
    fi
}

function get_real_user() {
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
        echo "$SUDO_USER"
    else
        whoami
    fi
}

function get_real_home() {
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
        getent passwd "$SUDO_USER" | cut -d: -f6
    else
        echo "$HOME"
    fi
}

function get_accounts_config_file() {
    local real_home
    real_home=$(get_real_home)
    if [ -f "${XDG_CONFIG_HOME:-$real_home/.config}/acer/accounts.conf" ]; then
        echo "${XDG_CONFIG_HOME:-$real_home/.config}/acer/accounts.conf"
    elif [ -f "$PROJECT_DIR/configs/accounts.conf" ]; then
        echo "$PROJECT_DIR/configs/accounts.conf"
    else
        echo ""
    fi
}

function load_account_presets() {
    ACCOUNT_PRESETS=()
    local cfg_file
    cfg_file=$(get_accounts_config_file)
    [ -z "$cfg_file" ] && return 0

    while IFS= read -r line; do
        line="${line%%#*}"
        line="$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [ -z "$line" ] && continue
        ACCOUNT_PRESETS+=("$line")
    done < "$cfg_file"
}

function get_laptop_model() {
    local vendor="" product=""
    [ -r /sys/devices/virtual/dmi/id/sys_vendor ] && vendor=$(cat /sys/devices/virtual/dmi/id/sys_vendor 2>/dev/null)
    [ -r /sys/devices/virtual/dmi/id/product_name ] && product=$(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null)
    if [ -n "$vendor" ] || [ -n "$product" ]; then
        echo "${vendor} ${product}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
    else
        echo "Acer Nitro AN517-41"
    fi
}

# Elevation helper untuk kontrol hardware (Kipas, RGB, Baterai, GPU)
function check_sudo_for_hw() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "\n${YELLOW}⚡ Fitur hardware memerlukan hak akses root (sudo)...${RESET}"
        exec sudo "$0" "$@"
    fi
}

function show_header() {
    clear
    echo -e "${CYAN}====================================================${RESET}"
    echo -e "${BOLD}${PURPLE}     🌸 ACER CONTROL & DEV SUITE (CLI) 🌸           ${RESET}"
    echo -e "${CYAN}====================================================${RESET}"
    echo -e "${BLUE}Laptop Model :${RESET} $(get_laptop_model)"
    echo -e "${BLUE}OS & Kernel  :${RESET} $(uname -srm)"
    echo -e "${BLUE}User         :${RESET} $(get_real_user) (EUID: $EUID)"
    echo -e "${CYAN}----------------------------------------------------${RESET}"
}

# ==========================================================
# 1. FAN CONTROL & SENSOR CONFIGURATOR
# ==========================================================
function resolve_fan_target_flag() {
    case "${1,,}" in
        cpu|left|kiri|0) echo "-f 0" ;;
        gpu|right|kanan|1) echo "-f 1" ;;
        *) echo "" ;;
    esac
}

function fan_target_label() {
    case "${1,,}" in
        cpu|left|kiri|0) echo "Kipas Kiri (CPU Fan #0)" ;;
        gpu|right|kanan|1) echo "Kipas Kanan (GPU Fan #1)" ;;
        *) echo "Kedua Kipas (CPU #0 & GPU #1)" ;;
    esac
}

function apply_fan_command() {
    local target="$1"
    local mode="$2"
    local speed="$3"
    local fan_flag
    fan_flag=$(resolve_fan_target_flag "$target")

    if [ "$mode" = "auto" ]; then
        if [ -n "$fan_flag" ]; then
            nbfc set -a $fan_flag
        else
            nbfc set -a
        fi
    else
        if [ -n "$fan_flag" ]; then
            nbfc set -s "$speed" $fan_flag
        else
            nbfc set -s "$speed"
        fi
    fi
}

function show_fan_sensor_menu() {
    while true; do
        show_header
        echo -e "${BOLD}${YELLOW}[ KONFIGURASI SENSOR SUHU KIPAS (NBFC SENSORS) ]${RESET}\n"
        echo -e "${CYAN}Mapping Sensor Saat Ini:${RESET}"
        nbfc sensors show 2>/dev/null | sed 's/^/  /'
        echo -e "\n${CYAN}Sensor Terdeteksi di Sistem:${RESET}"
        nbfc sensors list 2>/dev/null | grep -E "^[^[:space:]]|none" | sed 's/^/  /'
        echo -e "${CYAN}----------------------------------------------------${RESET}"
        echo -e "${BOLD}Pilih Kipas yang Ingin Diatur Sumber Sensornya:${RESET}"
        echo -e "  ${GREEN}1)${RESET} Fan #0 — Kipas Kiri (CPU Fan)"
        echo -e "  ${GREEN}2)${RESET} Fan #1 — Kipas Kanan (GPU Fan)"
        echo -e "  ${RED}0)${RESET} Kembali ke Menu Kipas"
        echo ""
        read -p "Pilih kipas [0-2]: " f_sel

        local target_idx=""
        case $f_sel in
            1) target_idx=0 ;;
            2) target_idx=1 ;;
            0) break ;;
            *) echo -e "${RED}Pilihan tidak valid!${RESET}"; sleep 1; continue ;;
        esac

        echo -e "\n${BOLD}Pilih Sumber Sensor Suhu untuk Fan #${target_idx}:${RESET}"
        echo -e "  ${GREEN}1)${RESET} Default Profile (@CPU / @GPU — reset override)"
        echo -e "  ${GREEN}2)${RESET} CPU AMD (k10temp)"
        echo -e "  ${GREEN}3)${RESET} AMD Radeon iGPU (amdgpu)"
        echo -e "  ${GREEN}4)${RESET} NVIDIA GeForce dGPU (nvidia-ml)"
        echo -e "  ${GREEN}5)${RESET} ACPI Thermal Zone (acpitz)"
        echo -e "  ${GREEN}6)${RESET} NVMe SSD (nvme)"
        echo -e "  ${GREEN}7)${RESET} Custom nama sensor"
        echo -e "  ${RED}0)${RESET} Batal"
        read -p "Pilih sensor [0-7]: " s_sel

        local chosen_sensor=""
        case $s_sel in
            1) chosen_sensor="@default" ;;
            2) chosen_sensor="k10temp" ;;
            3) chosen_sensor="amdgpu" ;;
            4) chosen_sensor="nvidia-ml" ;;
            5) chosen_sensor="acpitz" ;;
            6) chosen_sensor="nvme" ;;
            7) read -p "Masukkan nama sensor NBFC: " chosen_sensor ;;
            0) continue ;;
            *) echo -e "${RED}Pilihan tidak valid!${RESET}"; sleep 1; continue ;;
        esac

        [ -z "$chosen_sensor" ] && continue

        if [ "$chosen_sensor" = "@default" ]; then
            echo -e "\n${YELLOW}Mengembalikan sensor Fan #${target_idx} ke default profil...${RESET}"
            nbfc sensors set -f "$target_idx" && nbfc restart
            echo -e "${GREEN}✓ Sensor Fan #${target_idx} dikembalikan ke default!${RESET}"
        else
            echo -e "\nPilih Algoritma Kalkulasi Suhu:"
            echo "  1) Average (Rekomendasi)"
            echo "  2) Min"
            echo "  3) Max"
            read -p "Pilihan [1-3, default 1]: " a_sel
            local algo="Average"
            case $a_sel in
                2) algo="Min" ;;
                3) algo="Max" ;;
            esac

            echo -e "\n${YELLOW}Mengatur Fan #${target_idx} -> sensor '${chosen_sensor}' (${algo})...${RESET}"
            if nbfc sensors set -f "$target_idx" -s "$chosen_sensor" -a "$algo" --force; then
                nbfc restart
                echo -e "${GREEN}✓ Sensor Fan #${target_idx} berhasil diatur ke ${chosen_sensor} (${algo})!${RESET}"
            else
                echo -e "${RED}✗ Gagal mengatur sensor kipas.${RESET}"
            fi
        fi
        read -p "Tekan Enter untuk melanjutkan..."
    done
}

function show_fan_menu() {
    local current_target="${1:-both}"

    while true; do
        show_header
        echo -e "${BOLD}${YELLOW}[ PENGATURAN KIPAS (FAN CONTROL) ]${RESET}\n"

        # Display current fan status
        if command -v nbfc &>/dev/null; then
            echo -e "${GREEN}Status Terkini Kipas & Suhu:${RESET}"
            nbfc status 2>/dev/null | awk '
            /Fan Display Name/ { name=$NF; sub(".*: ", "", $0); name=$0 }
            /Temperature/ { temp=$NF }
            /Auto Control Enabled/ { auto=$NF }
            /Current Fan Speed/ { cur=$NF }
            /Target Fan Speed/ {
                tgt=$NF
                rpm=int(cur * 61.22)
                mode = (auto == "true") ? "Auto" : "Manual"
                side = (name ~ /CPU/) ? "Kiri #0" : "Kanan #1"
                printf "  [%-8s] %-8s : %5.1f°C | Mode: %-6s | Target: %5.1f%% | Aktual: %5.1f%% (~%d RPM)\n", side, name, temp, mode, tgt, cur, rpm
            }'
        fi

        echo -e "\n${CYAN}Target Aktif Saat Ini:${RESET} ${BOLD}$(fan_target_label "$current_target")${RESET}"
        echo -e "\n${BOLD}Pilih Aksi Pengaturan Kipas:${RESET}"
        echo -e "  ${GREEN}1)${RESET} Auto Mode (Otomatis ikuti suhu sensor)"
        echo -e "  ${GREEN}2)${RESET} Max / Turbo Speed (100% Full Speed)"
        echo -e "  ${GREEN}3)${RESET} Kecepatan Khusus (Set Manual 0-100%)"
        echo -e "  ${CYAN}4)${RESET} Ganti Target Kipas (Keduanya / Kiri CPU Saja / Kanan GPU Saja)"
        echo -e "  ${YELLOW}5)${RESET} Konfigurasi Sensor Suhu Kipas (CPU / AMD GPU / NVIDIA / ACPI)"
        echo -e "  ${BLUE}6)${RESET} Cek Status Kipas & Sensor Lengkap"
        echo -e "  ${RED}0)${RESET} Kembali ke Menu Utama"
        echo ""
        read -p "Masukkan pilihan [0-6]: " fan_choice

        case $fan_choice in
            1)
                echo -e "\n${YELLOW}Mengatur $(fan_target_label "$current_target") ke mode AUTO...${RESET}"
                apply_fan_command "$current_target" "auto"
                sleep 1
                echo -e "${GREEN}✓ Berhasil diatur ke mode AUTO!${RESET}"
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            2)
                echo -e "\n${RED}Mengatur $(fan_target_label "$current_target") ke MAKSIMAL (100%)...${RESET}"
                apply_fan_command "$current_target" "manual" "100"
                sleep 1
                echo -e "${GREEN}✓ Kipas sudah diatur ke 100%!${RESET}"
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            3)
                echo ""
                read -p "Masukkan persentase kecepatan kipas (0-100): " custom_speed
                if [[ "$custom_speed" =~ ^[0-9]+$ ]] && [ "$custom_speed" -ge 0 ] && [ "$custom_speed" -le 100 ]; then
                    echo -e "${YELLOW}Mengatur $(fan_target_label "$current_target") ke ${custom_speed}%...${RESET}"
                    apply_fan_command "$current_target" "manual" "$custom_speed"
                    sleep 1
                    echo -e "${GREEN}✓ Kipas diatur ke ${custom_speed}%!${RESET}"
                else
                    echo -e "${RED}Nilai tidak valid! Masukkan angka antara 0 - 100.${RESET}"
                fi
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            4)
                echo -e "\nPilih Target Kipas:"
                echo "  1) Keduanya (CPU #0 & GPU #1)"
                echo "  2) Kiri Saja (CPU Fan #0)"
                echo "  3) Kanan Saja (GPU Fan #1)"
                read -p "Pilihan [1-3]: " t_sel
                case $t_sel in
                    1) current_target="both" ;;
                    2) current_target="cpu" ;;
                    3) current_target="gpu" ;;
                    *) echo -e "${RED}Pilihan tidak valid!${RESET}"; sleep 1 ;;
                esac
                ;;
            5)
                show_fan_sensor_menu
                ;;
            6)
                echo -e "\n${CYAN}--- STATUS DETAIL NBFC ---${RESET}"
                nbfc status
                echo -e "\n${CYAN}--- KONFIGURASI SENSOR AKTIF ---${RESET}"
                nbfc sensors show
                echo -e "\n${YELLOW}ℹ️  Catatan Teknis:${RESET}"
                echo -e "  • ${BOLD}Target Fan Speed${RESET}  : Sinyal perintah duty cycle (PWM) yang dikirim ke chip EC."
                echo -e "  • ${BOLD}Current Fan Speed${RESET} : Kecepatan riil tachometer sensor fisik (fluktuatif wajar ±1-2%)."
                echo -e "  • Persentase aktual dihitung dari rasio RPM fisik terhadap MaxSpeed (6122 RPM)."
                echo ""
                read -p "Tekan Enter untuk kembali..."
                ;;
            0)
                break
                ;;
            *)
                echo -e "${RED}Pilihan tidak valid!${RESET}"
                sleep 1
                ;;
        esac
    done
}

# ==========================================================
# 2. KEYBOARD RGB
# ==========================================================
function show_keyboard_menu() {
    while true; do
        show_header
        echo -e "${BOLD}${YELLOW}[ PENGATURAN KEYBOARD RGB BACKLIGHT ]${RESET}\n"
        echo -e "  ${GREEN}1)${RESET} Nyalakan RGB - Efek Neon (Warna-warni berputar)"
        echo -e "  ${GREEN}2)${RESET} Nyalakan RGB - Efek Wave (Gelombang)"
        echo -e "  ${GREEN}3)${RESET} Nyalakan RGB - Efek Breathing (Pernapasan)"
        echo -e "  ${GREEN}4)${RESET} Nyalakan RGB - Static 1 Warna (Pilih warna)"
        echo -e "  ${GREEN}5)${RESET} Buka Wizard Pengaturan Keyboard Lengkap (keyboard.py)"
        echo -e "  ${RED}6)${RESET} Matikan Lampu Keyboard (Backlight OFF)"
        echo -e "  ${RED}0)${RESET} Kembali ke Menu Utama"
        echo ""
        read -p "Masukkan pilihan [0-6]: " kb_choice

        case $kb_choice in
            1)
                echo -e "\n${YELLOW}Menerapkan efek Neon...${RESET}"
                python3 "$FACER_RGB_SCRIPT" -m 2 -s 4 -b 100
                echo -e "${GREEN}✓ Efek Neon aktif!${RESET}"
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            2)
                echo -e "\n${YELLOW}Menerapkan efek Wave...${RESET}"
                python3 "$FACER_RGB_SCRIPT" -m 3 -s 5 -b 100
                echo -e "${GREEN}✓ Efek Wave aktif!${RESET}"
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            3)
                echo -e "\n${YELLOW}Menerapkan efek Breathing (Cyan)...${RESET}"
                python3 "$FACER_RGB_SCRIPT" -m 1 -s 3 -b 100 -cR 0 -cG 255 -cB 255
                echo -e "${GREEN}✓ Efek Breathing aktif!${RESET}"
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            4)
                echo -e "\nPilih Warna Static:"
                echo -e "  1) Cyan / Teal"
                echo -e "  2) Merah"
                echo -e "  3) Biru"
                echo -e "  4) Hijau"
                echo -e "  5) Putih"
                echo -e "  6) Ungu"
                echo -e "  0) Batal / Kembali"
                read -p "Pilihan warna [0-6]: " color_choice
                if [ "$color_choice" = "0" ] || [ -z "$color_choice" ]; then
                    continue
                fi
                case $color_choice in
                    1) python3 "$FACER_RGB_SCRIPT" -m 0 -z 1 -b 100 -cR 0 -cG 255 -cB 255 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 2 -b 100 -cR 0 -cG 255 -cB 255 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 3 -b 100 -cR 0 -cG 255 -cB 255 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 4 -b 100 -cR 0 -cG 255 -cB 255 ;;
                    2) python3 "$FACER_RGB_SCRIPT" -m 0 -z 1 -b 100 -cR 255 -cG 0 -cB 0 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 2 -b 100 -cR 255 -cG 0 -cB 0 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 3 -b 100 -cR 255 -cG 0 -cB 0 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 4 -b 100 -cR 255 -cG 0 -cB 0 ;;
                    3) python3 "$FACER_RGB_SCRIPT" -m 0 -z 1 -b 100 -cR 0 -cG 0 -cB 255 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 2 -b 100 -cR 0 -cG 0 -cB 255 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 3 -b 100 -cR 0 -cG 0 -cB 255 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 4 -b 100 -cR 0 -cG 0 -cB 255 ;;
                    4) python3 "$FACER_RGB_SCRIPT" -m 0 -z 1 -b 100 -cR 0 -cG 255 -cB 0 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 2 -b 100 -cR 0 -cG 255 -cB 0 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 3 -b 100 -cR 0 -cG 255 -cB 0 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 4 -b 100 -cR 0 -cG 255 -cB 0 ;;
                    5) python3 "$FACER_RGB_SCRIPT" -m 0 -z 1 -b 100 -cR 255 -cG 255 -cB 255 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 2 -b 100 -cR 255 -cG 255 -cB 255 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 3 -b 100 -cR 255 -cG 255 -cB 255 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 4 -b 100 -cR 255 -cG 255 -cB 255 ;;
                    6) python3 "$FACER_RGB_SCRIPT" -m 0 -z 1 -b 100 -cR 180 -cG 0 -cB 255 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 2 -b 100 -cR 180 -cG 0 -cB 255 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 3 -b 100 -cR 180 -cG 0 -cB 255 && python3 "$FACER_RGB_SCRIPT" -m 0 -z 4 -b 100 -cR 180 -cG 0 -cB 255 ;;
                    *) echo -e "${RED}Pilihan tidak valid!${RESET}"; sleep 1; continue ;;
                esac
                echo -e "${GREEN}✓ Warna static diterapkan!${RESET}"
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            5)
                (cd "$KEYBOARD_WIZARD_DIR" && python3 keyboard.py)
                ;;
            6)
                echo -e "\n${YELLOW}Mematikan lampu backlight keyboard...${RESET}"
                python3 "$FACER_RGB_SCRIPT" -b 0
                echo -e "${GREEN}✓ Lampu keyboard OFF!${RESET}"
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            0)
                break
                ;;
            *)
                echo -e "${RED}Pilihan tidak valid!${RESET}"
                sleep 1
                ;;
        esac
    done
}

# ==========================================================
# 3. BATTERY CARE & CHARGE LIMIT
# ==========================================================
function show_battery_menu() {
    local wmi_path="/sys/bus/wmi/drivers/acer-wmi-battery"
    local bat_path="/sys/class/power_supply/BAT1"

    while true; do
        show_header
        echo -e "${BOLD}${YELLOW}[ PENGATURAN BATERAI & CHARGE LIMIT (CUT-OFF) ]${RESET}\n"

        # Cek ketersediaan driver acer-wmi-battery
        if [ ! -d "$wmi_path" ]; then
            echo -e "${YELLOW}Memuat kernel module acer_wmi_battery...${RESET}"
            modprobe acer_wmi_battery 2>/dev/null
        fi

        # Baca status real-time baterai
        local capacity="N/A"
        local status="N/A"
        local temp="N/A"
        local health_mode="N/A"

        [ -f "$bat_path/capacity" ] && capacity=$(cat "$bat_path/capacity")
        [ -f "$bat_path/status" ] && status=$(cat "$bat_path/status")
        if [ -f "$wmi_path/temperature" ]; then
            local raw_temp=$(cat "$wmi_path/temperature" 2>/dev/null)
            [ -n "$raw_temp" ] && temp="$((raw_temp / 1000))°C"
        fi

        if [ -f "$wmi_path/health_mode" ]; then
            local hm_val=$(cat "$wmi_path/health_mode" 2>/dev/null)
            if [ "$hm_val" = "1" ]; then
                health_mode="${GREEN}AKTIF (Batas 80% ON - Cut-Off)${RESET}"
            elif [ "$hm_val" = "0" ]; then
                health_mode="${YELLOW}NONAKTIF (Full Charge 100%)${RESET}"
            fi
        else
            health_mode="${RED}Driver Belum Terhubung${RESET}"
        fi

        echo -e "${CYAN}Informasi Baterai Saat Ini:${RESET}"
        echo -e "  • Persentase Daya : ${BOLD}${capacity}%${RESET}"
        echo -e "  • Status Pengisian: ${BOLD}${status}${RESET}"
        echo -e "  • Suhu Baterai    : ${BOLD}${temp}${RESET}"
        echo -e "  • Batas Cas (Limit): ${health_mode}"
        echo -e "${CYAN}----------------------------------------------------${RESET}"
        echo -e "${BOLD}Pilih Aksi:${RESET}"
        echo -e "  ${GREEN}1)${RESET} Aktifkan Batas Cas 80% (Battery Care / Cut-Off ON)"
        echo -e "  ${GREEN}2)${RESET} Matikan Batas Cas (Cas Penuh 100% / Normal)"
        echo -e "  ${GREEN}3)${RESET} Simpan Pengaturan Permanen Saat Booting"
        echo -e "  ${RED}0)${RESET} Kembali ke Menu Utama"
        echo ""
        read -p "Masukkan pilihan [0-3]: " bat_choice

        case $bat_choice in
            1)
                echo -e "\n${YELLOW}Mengaktifkan batas cas 80%...${RESET}"
                if [ -f "$wmi_path/health_mode" ]; then
                    echo 1 > "$wmi_path/health_mode"
                    echo -e "${GREEN}✓ Batas cas 80% (Health Mode) BERHASIL DIAKTIFKAN!${RESET}"
                    echo -e "  ${BLUE}Catatan:${RESET} Pengisian akan otomatis berhenti/cut-off saat mencapai 80%."
                else
                    echo -e "${RED}Gagal: Node $wmi_path/health_mode tidak ditemukan!${RESET}"
                fi
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            2)
                echo -e "\n${YELLOW}Mematikan batas cas (mengizinkan cas hingga 100%)...${RESET}"
                if [ -f "$wmi_path/health_mode" ]; then
                    echo 0 > "$wmi_path/health_mode"
                    echo -e "${GREEN}✓ Batas cas DINONAKTIFKAN! Laptop dapat mengisi penuh hingga 100%.${RESET}"
                else
                    echo -e "${RED}Gagal: Node $wmi_path/health_mode tidak ditemukan!${RESET}"
                fi
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            3)
                echo -e "\n${YELLOW}Menyimpan konfigurasi modul ke /etc/modprobe.d/acer-wmi-battery.conf...${RESET}"
                echo "options acer_wmi_battery enable_health_mode=1" > /etc/modprobe.d/acer-wmi-battery.conf
                echo -e "${GREEN}✓ Konfigurasi tersimpan! Health Mode 80% akan otomatis aktif saat laptop menyala.${RESET}"
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            0)
                break
                ;;
            *)
                echo -e "${RED}Pilihan tidak valid!${RESET}"
                sleep 1
                ;;
        esac
    done
}

# ==========================================================
# 4. GPU SWITCHER (HYBRID, INTEGRATED/iGPU, NVIDIA dGPU)
# ==========================================================
function show_gpu_menu() {
    while true; do
        show_header
        echo -e "${BOLD}${YELLOW}[ 🎮 PENGATURAN MODE GRAFIS / GPU (SWITCHER) ]${RESET}\n"

        local cur_mode="unknown"
        if command -v envycontrol &>/dev/null; then
            cur_mode=$(envycontrol -q 2>/dev/null || echo "unknown")
        fi

        echo -e "  Status Mode GPU Saat Ini : ${BOLD}${GREEN}${cur_mode^^}${RESET}"
        echo -e "  GPU 1 (Integrated / iGPU): AMD Radeon™ Vega / Cezanne"
        echo -e "  GPU 2 (Dedicated / dGPU) : NVIDIA GeForce RTX™ 3080 Mobile\n"
        echo -e "${CYAN}----------------------------------------------------${RESET}"
        echo -e "  ${CYAN}[1]${RESET} ⚡ ${BOLD}Mode Hybrid${RESET} (Otomatis: iGPU hemat daya + NVIDIA via On-Demand)"
        echo -e "  ${CYAN}[2]${RESET} 🍃 ${BOLD}Mode Integrated / iGPU${RESET} (Hemat baterai maksimal, NVIDIA dimatikan)"
        echo -e "  ${CYAN}[3]${RESET} 🚀 ${BOLD}Mode NVIDIA (dGPU Only)${RESET} (Performa grafis penuh 100% RTX 3080)"
        echo -e "  ${CYAN}[4]${RESET} 🔍 ${BOLD}Cek Status & Informasi Device GPU${RESET}"
        echo -e "  ${RED}[0]${RESET} ⬅️  Kembali ke Menu Utama\n"
        read -p "Masukkan pilihan [0-4]: " gpu_choice

        case $gpu_choice in
            1)
                echo -e "\n${YELLOW}Mengganti mode GPU ke HYBRID...${RESET}"
                if sudo envycontrol -s hybrid; then
                    echo -e "\n${GREEN}✅ Mode GPU berhasil diatur ke HYBRID!${RESET}"
                    echo -e "${YELLOW}Catatan: Silakan REBOOT laptop agar perubahan mode aktif sepenuhnya.${RESET}"
                else
                    echo -e "\n${RED}❌ Gagal mengubah mode GPU!${RESET}"
                fi
                read -p "Tekan Enter untuk lanjut..."
                ;;
            2)
                echo -e "\n${YELLOW}Mengganti mode GPU ke INTEGRATED (iGPU)... ${RESET}"
                if sudo envycontrol -s integrated; then
                    echo -e "\n${GREEN}✅ Mode GPU berhasil diatur ke INTEGRATED (iGPU)!${RESET}"
                    echo -e "${YELLOW}Catatan: Silakan REBOOT laptop agar perubahan mode aktif sepenuhnya.${RESET}"
                else
                    echo -e "\n${RED}❌ Gagal mengubah mode GPU!${RESET}"
                fi
                read -p "Tekan Enter untuk lanjut..."
                ;;
            3)
                echo -e "\n${YELLOW}Mengganti mode GPU ke NVIDIA (Dedicated)... ${RESET}"
                if sudo envycontrol -s nvidia; then
                    echo -e "\n${GREEN}✅ Mode GPU berhasil diatur ke NVIDIA!${RESET}"
                    echo -e "${YELLOW}Catatan: Silakan REBOOT laptop agar perubahan mode aktif sepenuhnya.${RESET}"
                else
                    echo -e "\n${RED}❌ Gagal mengubah mode GPU!${RESET}"
                fi
                read -p "Tekan Enter untuk lanjut..."
                ;;
            4)
                echo -e "\n${CYAN}--- Detail GPU (switcherooctl list) ---${RESET}"
                switcherooctl list 2>/dev/null || echo -e "${RED}switcherooctl tidak tersedia.${RESET}"
                echo -e "\n${CYAN}--- Status EnvyControl ---${RESET}"
                envycontrol -q 2>/dev/null
                echo ""
                read -p "Tekan Enter untuk kembali..."
                ;;
            0)
                return
                ;;
            *)
                echo -e "${RED}Pilihan tidak valid!${RESET}"
                sleep 1
                ;;
        esac
    done
}

# ==========================================================
# 4. GIT & GITHUB DEVELOPER SUITE
# ==========================================================
function show_git_header() {
    show_header
    echo -e "${BOLD}${YELLOW}[ 🌿 GIT & GITHUB DEVELOPER SUITE ]${RESET}\n"
    if is_in_git_repo; then
        local repo_root branch remote_url status_sum
        repo_root=$(run_as_user git rev-parse --show-toplevel 2>/dev/null)
        branch=$(run_as_user git branch --show-current 2>/dev/null)
        [ -z "$branch" ] && branch="(detached HEAD)"
        remote_url=$(run_as_user git remote get-url origin 2>/dev/null || echo "Tidak ada remote origin")
        
        # Local vs Global Author
        local local_author local_email global_author global_email
        local_author=$(git config --local user.name 2>/dev/null)
        local_email=$(git config --local user.email 2>/dev/null)
        global_author=$(git config --global user.name 2>/dev/null)
        global_email=$(git config --global user.email 2>/dev/null)

        local local_gh global_gh
        local_gh=$(git config --local github.user 2>/dev/null)
        global_gh=$(gh api user --jq .login 2>/dev/null || echo "Belum login")

        local author_str gh_str
        if [ -n "$local_author" ]; then
            author_str="${GREEN}${local_author}${RESET} <${local_email}> ${YELLOW}[LOKAL REPO]${RESET}"
        else
            author_str="${PURPLE}${global_author:-Belum diset}${RESET} <${global_email:-}> ${CYAN}[GLOBAL]${RESET}"
        fi

        if [ -n "$local_gh" ]; then
            gh_str="${GREEN}${local_gh}${RESET} ${YELLOW}[LOKAL REPO OVERRIDE]${RESET} (Global: ${global_gh})"
        else
            gh_str="${BLUE}${global_gh}${RESET} ${CYAN}[GLOBAL]${RESET}"
        fi

        # Check dirty status
        if [ -z "$(run_as_user git status --porcelain 2>/dev/null)" ]; then
            status_sum="${GREEN}Bersih (Clean)${RESET}"
        else
            local changes_count
            changes_count=$(run_as_user git status --porcelain 2>/dev/null | wc -l)
            status_sum="${YELLOW}Ada Perubahan (${changes_count} file)${RESET}"
        fi

        echo -e "${CYAN}Info Repository Saat Ini:${RESET}"
        echo -e "  • ${BOLD}Folder Repo :${RESET} ${repo_root}"
        echo -e "  • ${BOLD}Branch Aktif:${RESET} ${GREEN}${branch}${RESET}"
        echo -e "  • ${BOLD}Status Tree :${RESET} ${status_sum}"
        echo -e "  • ${BOLD}Git Author  :${RESET} ${author_str}"
        echo -e "  • ${BOLD}GitHub CLI  :${RESET} ${gh_str}"
        echo -e "  • ${BOLD}Origin URL  :${RESET} ${remote_url}"
        echo -e "${CYAN}----------------------------------------------------${RESET}"
    else
        local active_gh global_author global_email
        active_gh=$(gh api user --jq .login 2>/dev/null || echo "Belum login")
        global_author=$(git config --global user.name 2>/dev/null || echo "Belum diset")
        global_email=$(git config --global user.email 2>/dev/null || echo "Belum diset")
        echo -e "${YELLOW}⚠️  Direktori saat ini ($(pwd)) bukan repository Git!${RESET}"
        echo -e "  • ${BOLD}GitHub CLI :${RESET} ${BLUE}${active_gh}${RESET}"
        echo -e "  • ${BOLD}Git Global :${RESET} ${PURPLE}${global_author}${RESET} <${global_email}>"
        echo -e "${CYAN}----------------------------------------------------${RESET}"
    fi
}

function apply_local_account() {
    local acc="$1"
    local author_name="$2"
    local author_email="$3"

    if ! is_in_git_repo; then
        echo -e "${RED}Perintah ini hanya bisa dijalankan di dalam repository Git!${RESET}"
        read -p "Tekan Enter untuk kembali..."
        return 1
    fi

    echo -e "\n${YELLOW}Mengonfigurasi akun LOKAL repo untuk: ${BOLD}${acc}${RESET}..."

    # 1. Set Git Author Lokal
    run_as_user git config --local user.name "$author_name"
    run_as_user git config --local user.email "$author_email"

    # 2. Set Local GitHub User Marker
    run_as_user git config --local github.user "$acc"

    # 3. Set Credential Helper Lokal agar Git Push/Pull selalu pakai token akun ini
    run_as_user git config --local --unset-all credential.helper 2>/dev/null || true
    run_as_user git config --local credential.helper ""
    run_as_user git config --local --add credential.helper "!f() { test \"\$1\" = get && echo \"username=$acc\" && echo \"password=\$(gh auth token -u $acc)\"; }; f"

    # 4. Sesuaikan remote origin URL jika HTTPS GitHub
    local cur_url
    cur_url=$(run_as_user git remote get-url origin 2>/dev/null)
    if [[ "$cur_url" =~ github\.com ]]; then
        local new_url
        new_url=$(echo "$cur_url" | sed -E "s#(https://)([^@]+@)?github\.com/#\\1${acc}@github.com/#")
        run_as_user git remote set-url origin "$new_url"
        echo -e "${BLUE}• Remote origin URL diupdate ke:${RESET} $new_url"
    fi

    echo -e "${GREEN}✓ Akun LOKAL repo berhasil diset ke:${RESET} ${acc} (${author_name} <${author_email}>)"
    echo -e "${CYAN}ℹ️  Pengaturan ini HANYA berlaku untuk repo ini dan TIDAK mengubah konfigurasi global!${RESET}"
}

function reset_local_account() {
    if ! is_in_git_repo; then
        echo -e "${RED}Perintah ini hanya bisa dijalankan di dalam repository Git!${RESET}"
        return 1
    fi

    echo -e "\n${YELLOW}Menghapus override lokal repo...${RESET}"
    run_as_user git config --local --unset user.name 2>/dev/null || true
    run_as_user git config --local --unset user.email 2>/dev/null || true
    run_as_user git config --local --unset github.user 2>/dev/null || true
    run_as_user git config --local --unset-all credential.helper 2>/dev/null || true

    # Bersihkan prefix user di remote origin jika ada
    local cur_url
    cur_url=$(run_as_user git remote get-url origin 2>/dev/null)
    if [[ "$cur_url" =~ github\.com ]]; then
        local clean_url
        clean_url=$(echo "$cur_url" | sed -E 's#(https://)([^@]+@)github\.com/#\1github.com/#')
        run_as_user git remote set-url origin "$clean_url"
        echo -e "${BLUE}• Remote origin URL dikembalikan ke:${RESET} $clean_url"
    fi

    echo -e "${GREEN}✓ Override lokal dihapus! Repo ini sekarang mengikuti konfigurasi Global.${RESET}"
}

function show_git_pull_menu() {
    if ! is_in_git_repo; then
        echo -e "${RED}Perintah ini hanya bisa dijalankan di dalam repository Git!${RESET}"
        read -p "Tekan Enter untuk kembali..."
        return
    fi
    while true; do
        show_git_header
        echo -e "${BOLD}${YELLOW}[ PULL & SYNC REPOSITORY ]${RESET}\n"
        echo -e "  ${GREEN}1)${RESET} 🔄 Quick Pull (git pull)"
        echo -e "  ${GREEN}2)${RESET} 🔀 Pull with Rebase (git pull --rebase)"
        echo -e "  ${GREEN}3)${RESET} 📥 Fetch All & Prune (git fetch --all --prune)"
        echo -e "  ${GREEN}4)${RESET} 🎯 Pull dari Remote & Branch Spesifik"
        echo -e "  ${RED}0)${RESET} 🔙 Kembali ke Menu Git"
        echo ""
        read -p "Pilihan [0-4]: " p_choice
        case $p_choice in
            1)
                echo -e "\n${YELLOW}Menjalankan git pull...${RESET}"
                run_as_user git pull
                echo ""
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            2)
                echo -e "\n${YELLOW}Menjalankan git pull --rebase...${RESET}"
                run_as_user git pull --rebase
                echo ""
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            3)
                echo -e "\n${YELLOW}Menjalankan git fetch --all --prune...${RESET}"
                run_as_user git fetch --all --prune
                echo -e "${GREEN}✓ Fetch & prune selesai!${RESET}"
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            4)
                read -p "Nama remote [origin]: " rem_input
                [ -z "$rem_input" ] && rem_input="origin"
                read -p "Nama branch: " br_input
                if [ -n "$br_input" ]; then
                    echo -e "\n${YELLOW}Menjalankan git pull $rem_input $br_input...${RESET}"
                    run_as_user git pull "$rem_input" "$br_input"
                else
                    echo -e "${RED}Nama branch tidak boleh kosong!${RESET}"
                fi
                echo ""
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            0) break ;;
            *) echo -e "${RED}Pilihan tidak valid!${RESET}"; sleep 1 ;;
        esac
    done
}

function show_git_working_menu() {
    if ! is_in_git_repo; then
        echo -e "${RED}Perintah ini hanya bisa dijalankan di dalam repository Git!${RESET}"
        read -p "Tekan Enter untuk kembali..."
        return
    fi
    while true; do
        show_git_header
        echo -e "${BOLD}${YELLOW}[ WORKING TREE & CHANGES ]${RESET}\n"
        echo -e "  ${GREEN}1)${RESET} 📊 Status Lengkap (git status)"
        echo -e "  ${GREEN}2)${RESET} 🔍 Lihat Diff Unstaged (git diff)"
        echo -e "  ${GREEN}3)${RESET} 📑 Lihat Diff Staged (git diff --staged)"
        echo -e "  ${GREEN}4)${RESET} 📦 Stash Changes (git stash push -m)"
        echo -e "  ${GREEN}5)${RESET} 📤 Pop Stash Terakhir (git stash pop)"
        echo -e "  ${GREEN}6)${RESET} 📋 Lihat Riwayat Stash (git stash list)"
        echo -e "  ${RED}7)${RESET} ⚠️  Discard Semua Perubahan Unstaged (git restore .)"
        echo -e "  ${RED}8)${RESET} 🧹 Bersihkan File Untracked (git clean -fd)"
        echo -e "  ${RED}0)${RESET} 🔙 Kembali ke Menu Git"
        echo ""
        read -p "Pilihan [0-8]: " w_choice
        case $w_choice in
            1)
                echo -e "\n${CYAN}--- STATUS GIT ---${RESET}"
                run_as_user git status
                echo ""
                read -p "Tekan Enter untuk kembali..."
                ;;
            2)
                echo -e "\n${CYAN}--- DIFF (UNSTAGED) ---${RESET}"
                run_as_user git diff
                echo ""
                read -p "Tekan Enter untuk kembali..."
                ;;
            3)
                echo -e "\n${CYAN}--- DIFF (STAGED) ---${RESET}"
                run_as_user git diff --staged
                echo ""
                read -p "Tekan Enter untuk kembali..."
                ;;
            4)
                read -p "Catatan stash (opsional): " stash_msg
                if [ -n "$stash_msg" ]; then
                    run_as_user git stash push -m "$stash_msg"
                else
                    run_as_user git stash push
                fi
                echo ""
                read -p "Tekan Enter untuk kembali..."
                ;;
            5)
                run_as_user git stash pop
                echo ""
                read -p "Tekan Enter untuk kembali..."
                ;;
            6)
                echo -e "\n${CYAN}--- DAFTAR STASH ---${RESET}"
                run_as_user git stash list
                echo ""
                read -p "Tekan Enter untuk kembali..."
                ;;
            7)
                read -p "Yakin ingin membatalkan semua perubahan unstaged? (y/N): " confirm_restore
                if [[ "$confirm_restore" =~ ^[Yy]$ ]]; then
                    run_as_user git restore .
                    echo -e "${GREEN}✓ Semua perubahan unstaged dibatalkan!${RESET}"
                fi
                read -p "Tekan Enter untuk kembali..."
                ;;
            8)
                read -p "Yakin ingin menghapus semua file untracked? (y/N): " confirm_clean
                if [[ "$confirm_clean" =~ ^[Yy]$ ]]; then
                    run_as_user git clean -fd
                    echo -e "${GREEN}✓ File untracked dibersihkan!${RESET}"
                fi
                read -p "Tekan Enter untuk kembali..."
                ;;
            0) break ;;
            *) echo -e "${RED}Pilihan tidak valid!${RESET}"; sleep 1 ;;
        esac
    done
}

function show_git_switch_account_menu() {
    while true; do
        show_git_header
        echo -e "${BOLD}${YELLOW}[ SWITCH AKUN & IDENTITAS GITHUB ]${RESET}\n"
        
        # Baca akun yang tersimpan di gh
        local gh_accounts=()
        while IFS= read -r acc; do
            [ -n "$acc" ] && gh_accounts+=("$acc")
        done < <(gh auth status 2>&1 | grep -oP 'account \K[^ ]+' | sort -u)

        load_account_presets

        local current_gh local_gh
        current_gh=$(gh api user --jq .login 2>/dev/null || echo "Belum login")
        local_gh=""
        is_in_git_repo && local_gh=$(git config --local github.user 2>/dev/null)

        echo -e "${CYAN}Daftar Akun GitHub Tersedia:${RESET}"
        if [ ${#gh_accounts[@]} -eq 0 ]; then
            echo -e "  ${YELLOW}(Tidak ada akun terdeteksi di gh)${RESET}"
        else
            for acc in "${gh_accounts[@]}"; do
                local tag=""
                if [ "$acc" = "$local_gh" ]; then
                    tag="${GREEN}[LOKAL REPO INI]${RESET} "
                fi
                if [ "$acc" = "$current_gh" ]; then
                    tag="${tag}${BLUE}[GLOBAL SISTEM]${RESET}"
                fi
                [ -z "$tag" ] && tag="${RESET}○ Tersimpan"
                echo -e "  • ${BOLD}${acc}${RESET} -> ${tag}"
            done
        fi
        echo ""
        echo -e "${BOLD}Pilih Aksi Penggantian Akun:${RESET}"
        echo -e "  ${YELLOW}─── [ SWITCH LOKAL REPO (Hanya Berlaku di Repo Ini) ] ───${RESET}"
        echo -e "  ${GREEN}1)${RESET} ⚡ 1-Click LOKAL dari Preset (${BOLD}accounts.conf${RESET})"
        echo -e "  ${GREEN}2)${RESET} 🎯 Switch LOKAL ke Akun GitHub CLI (Pilih dari daftar akun)"
        echo -e "  ${YELLOW}3)${RESET} 🔄 Reset Override LOKAL (Kembali ikuti pengaturan Global)"
        echo ""
        echo -e "  ${YELLOW}─── [ SWITCH GLOBAL (Berlaku di Seluruh Sistem) ] ───${RESET}"
        echo -e "  ${BLUE}4)${RESET} 👤 Ganti Akun Global GitHub CLI (gh auth switch)"
        echo -e "  ${BLUE}5)${RESET} 🌐 Ganti Git Author Global (git config --global user.name/email)"
        echo ""
        echo -e "  ${YELLOW}─── [ UTILITY & DETAIL ] ───${RESET}"
        echo -e "  ${CYAN}6)${RESET} ✍️  Edit Manual Git Author Repo Ini (user.name & user.email lokal)"
        echo -e "  ${CYAN}7)${RESET} ➕ Login Akun Baru ke GitHub CLI (gh auth login)"
        echo -e "  ${CYAN}8)${RESET} 🔍 Cek Status Detail Autentikasi (gh auth status & git config)"
        echo -e "  ${RED}0)${RESET} 🔙 Kembali ke Menu Git"
        echo ""
        read -p "Pilihan [0-8]: " s_choice
        case $s_choice in
            1)
                if [ ${#ACCOUNT_PRESETS[@]} -eq 0 ]; then
                    echo -e "\n${YELLOW}Belum ada preset di ~/.config/acer/accounts.conf${RESET}"
                    echo -e "Contoh format tersedia di: ${CYAN}$PROJECT_DIR/configs/accounts.example.conf${RESET}"
                    read -p "Tekan Enter untuk kembali..."
                    continue
                fi
                echo -e "\n${CYAN}Pilih Preset Akun Lokal Repo:${RESET}"
                local pidx=1
                for entry in "${ACCOUNT_PRESETS[@]}"; do
                    IFS='|' read -r p_alias p_gh p_name p_mail <<< "$entry"
                    echo -e "  ${GREEN}${pidx})${RESET} ${BOLD}${p_gh}${RESET} (${p_alias}) — ${p_name} <${p_mail}>"
                    ((pidx++))
                done
                echo "  0) Batal / Kembali"
                read -p "Pilihan [0-$((pidx-1))]: " p_sel
                if [ "$p_sel" = "0" ] || [ -z "$p_sel" ]; then
                    continue
                fi
                if [[ "$p_sel" =~ ^[0-9]+$ ]] && [ "$p_sel" -ge 1 ] && [ "$p_sel" -le "${#ACCOUNT_PRESETS[@]}" ]; then
                    IFS='|' read -r p_alias p_gh p_name p_mail <<< "${ACCOUNT_PRESETS[$((p_sel-1))]}"
                    apply_local_account "$p_gh" "$p_name" "$p_mail"
                else
                    echo -e "${RED}Pilihan preset tidak valid!${RESET}"
                fi
                read -p "Tekan Enter untuk kembali..."
                ;;
            2)
                if ! is_in_git_repo; then
                    echo -e "${RED}Perintah ini hanya bisa dijalankan di dalam repository Git!${RESET}"
                    read -p "Tekan Enter untuk kembali..."
                    continue
                fi
                echo -e "\nPilih akun GitHub untuk repository ini:"
                local idx=1
                for acc in "${gh_accounts[@]}"; do
                    echo "  $idx) $acc"
                    ((idx++))
                done
                echo "  0) Batal / Kembali"
                read -p "Pilihan [0-$((idx-1))]: " c_idx
                if [ "$c_idx" = "0" ] || [ -z "$c_idx" ]; then
                    continue
                fi
                if [[ "$c_idx" =~ ^[0-9]+$ ]] && [ "$c_idx" -ge 1 ] && [ "$c_idx" -le "${#gh_accounts[@]}" ]; then
                    local chosen_acc="${gh_accounts[$((c_idx-1))]}"
                    read -p "Masukkan nama author untuk git commit [$chosen_acc]: " c_name
                    [ -z "$c_name" ] && c_name="$chosen_acc"
                    read -p "Masukkan email author: " c_mail
                    if [ -n "$c_mail" ]; then
                        apply_local_account "$chosen_acc" "$c_name" "$c_mail"
                        read -p "Tekan Enter untuk kembali..."
                    else
                        echo -e "${RED}Email tidak boleh kosong!${RESET}"
                        read -p "Tekan Enter untuk kembali..."
                    fi
                else
                    echo -e "${RED}Nomor akun tidak valid!${RESET}"
                    read -p "Tekan Enter untuk kembali..."
                fi
                ;;
            3)
                reset_local_account
                read -p "Tekan Enter untuk kembali..."
                ;;
            4)
                echo -e "\n${YELLOW}Memilih akun Global GitHub CLI...${RESET}"
                if [ ${#gh_accounts[@]} -gt 0 ]; then
                    echo "Daftar Akun:"
                    local idx=1
                    for acc in "${gh_accounts[@]}"; do
                        echo "  $idx) $acc"
                        ((idx++))
                    done
                    echo "  0) Batal / Kembali"
                    read -p "Pilih nomor akun untuk dijadikan GLOBAL [0-$((idx-1))]: " acc_idx
                    if [ "$acc_idx" = "0" ] || [ -z "$acc_idx" ]; then
                        continue
                    fi
                    if [[ "$acc_idx" =~ ^[0-9]+$ ]] && [ "$acc_idx" -ge 1 ] && [ "$acc_idx" -le "${#gh_accounts[@]}" ]; then
                        local chosen_acc="${gh_accounts[$((acc_idx-1))]}"
                        echo -e "${YELLOW}Beralih ke akun global ${chosen_acc}...${RESET}"
                        gh auth switch --hostname github.com --user "$chosen_acc"
                        echo -e "${GREEN}✓ Akun Global GitHub CLI berhasil diganti ke: ${chosen_acc}${RESET}"
                        read -p "Tekan Enter untuk kembali..."
                    else
                        echo -e "${RED}Nomor akun tidak valid!${RESET}"
                        read -p "Tekan Enter untuk kembali..."
                    fi
                else
                    gh auth switch
                    read -p "Tekan Enter untuk kembali..."
                fi
                ;;
            5)
                echo -e "\nPilih preset atau custom untuk Global Git Author:"
                local gidx=1
                for entry in "${ACCOUNT_PRESETS[@]}"; do
                    IFS='|' read -r p_alias p_gh p_name p_mail <<< "$entry"
                    echo "  ${gidx}) ${p_gh} — ${p_name} <${p_mail}>"
                    ((gidx++))
                done
                local custom_opt=$gidx
                echo "  ${custom_opt}) Custom Nama & Email"
                echo "  0) Batal / Kembali"
                read -p "Pilihan [0-${custom_opt}]: " g_choice
                if [ "$g_choice" = "0" ] || [ -z "$g_choice" ]; then
                    continue
                elif [ "$g_choice" = "$custom_opt" ]; then
                    read -p "Masukkan nama author global (kosongkan untuk batal): " c_name
                    if [ -n "$c_name" ]; then
                        read -p "Masukkan email author global: " c_email
                        if [ -n "$c_email" ]; then
                            run_as_user git config --global user.name "$c_name"
                            run_as_user git config --global user.email "$c_email"
                            echo -e "${GREEN}✓ Global Git author diatur ke: $c_name <$c_email>${RESET}"
                            read -p "Tekan Enter untuk kembali..."
                        fi
                    fi
                elif [[ "$g_choice" =~ ^[0-9]+$ ]] && [ "$g_choice" -ge 1 ] && [ "$g_choice" -le "${#ACCOUNT_PRESETS[@]}" ]; then
                    IFS='|' read -r p_alias p_gh p_name p_mail <<< "${ACCOUNT_PRESETS[$((g_choice-1))]}"
                    run_as_user git config --global user.name "$p_name"
                    run_as_user git config --global user.email "$p_mail"
                    echo -e "${GREEN}✓ Global Git author diatur ke: $p_name <$p_mail>${RESET}"
                    read -p "Tekan Enter untuk kembali..."
                else
                    echo -e "${RED}Pilihan tidak valid!${RESET}"
                    sleep 1
                fi
                ;;
            6)
                if ! is_in_git_repo; then
                    echo -e "${RED}Bukan repository Git!${RESET}"
                    read -p "Tekan Enter untuk kembali..."
                    continue
                fi
                read -p "Masukkan nama author lokal repo (kosongkan untuk batal): " l_name
                if [ -n "$l_name" ]; then
                    read -p "Masukkan email author lokal repo: " l_email
                    if [ -n "$l_email" ]; then
                        run_as_user git config --local user.name "$l_name"
                        run_as_user git config --local user.email "$l_email"
                        echo -e "${GREEN}✓ Git author lokal repo diatur ke: $l_name <$l_email>${RESET}"
                        read -p "Tekan Enter untuk kembali..."
                    fi
                fi
                ;;
            7)
                echo -e "\n${YELLOW}Membuka wizard login GitHub CLI...${RESET}"
                gh auth login
                read -p "Tekan Enter untuk kembali..."
                ;;
            8)
                echo -e "\n${CYAN}--- STATUS AUTENTIKASI DETAIL ---${RESET}"
                gh auth status
                echo ""
                echo -e "${YELLOW}Konfigurasi Git Author Saat Ini:${RESET}"
                run_as_user git config --list --show-origin | grep -E "user\.name|user\.email|github\.user|credential\.helper" || true
                echo ""
                read -p "Tekan Enter untuk kembali..."
                ;;
            0) break ;;
            *) echo -e "${RED}Pilihan tidak valid!${RESET}"; sleep 1 ;;
        esac
    done
}

function show_git_remote_menu() {
    if ! is_in_git_repo; then
        echo -e "${RED}Perintah ini hanya bisa dijalankan di dalam repository Git!${RESET}"
        read -p "Tekan Enter untuk kembali..."
        return
    fi
    while true; do
        show_git_header
        echo -e "${BOLD}${YELLOW}[ REMOTE REPOSITORY MANAGER ]${RESET}\n"
        echo -e "${CYAN}Daftar Remote Saat Ini:${RESET}"
        run_as_user git remote -v | sed 's/^/  /'
        echo ""
        echo -e "${BOLD}Pilih Aksi Remote:${RESET}"
        echo -e "  ${GREEN}1)${RESET} ✏️  Ganti URL Remote Origin (Set URL)"
        echo -e "  ${GREEN}2)${RESET} 🔄 Ganti Akun Prefix di URL Origin (cth: https://user@github.com/...)"
        echo -e "  ${GREEN}3)${RESET} ➕ Tambah Remote Baru (git remote add)"
        echo -e "  ${RED}4)${RESET} ❌ Hapus Remote (git remote remove)"
        echo -e "  ${BLUE}5)${RESET} 📡 Test Koneksi Remote (git ls-remote)"
        echo -e "  ${RED}0)${RESET} 🔙 Kembali ke Menu Git"
        echo ""
        read -p "Pilihan [0-5]: " r_choice
        case $r_choice in
            1)
                local cur_orig
                cur_orig=$(run_as_user git remote get-url origin 2>/dev/null)
                echo -e "URL Origin saat ini: ${BOLD}${cur_orig}${RESET}"
                read -p "Masukkan URL baru: " new_orig
                if [ -n "$new_orig" ]; then
                    run_as_user git remote set-url origin "$new_orig"
                    echo -e "${GREEN}✓ Remote origin berhasil diupdate!${RESET}"
                fi
                read -p "Tekan Enter untuk kembali..."
                ;;
            2)
                local cur_orig
                cur_orig=$(run_as_user git remote get-url origin 2>/dev/null)
                echo -e "URL Origin saat ini: ${BOLD}${cur_orig}${RESET}"
                local gh_accs=()
                while IFS= read -r acc; do
                    [ -n "$acc" ] && gh_accs+=("$acc")
                done < <(gh auth status 2>&1 | grep -oP 'account \K[^ ]+' | sort -u)

                echo "Pilih opsi prefix:"
                local pidx=1
                for acc in "${gh_accs[@]}"; do
                    echo "  ${pidx}) Pasang prefix: ${acc}@github.com"
                    ((pidx++))
                done
                local opt_clean=$pidx
                local opt_custom=$((pidx+1))
                echo "  ${opt_clean}) Bersihkan prefix (hanya github.com)"
                echo "  ${opt_custom}) Custom username prefix"
                echo "  0) Batal / Kembali"
                read -p "Pilihan [0-${opt_custom}]: " pfx_choice
                if [ "$pfx_choice" = "0" ] || [ -z "$pfx_choice" ]; then
                    continue
                fi
                local target_user=""
                if [ "$pfx_choice" = "$opt_clean" ]; then
                    target_user=""
                elif [ "$pfx_choice" = "$opt_custom" ]; then
                    read -p "Masukkan username: " u_in
                    [ -n "$u_in" ] && target_user="${u_in}@"
                elif [[ "$pfx_choice" =~ ^[0-9]+$ ]] && [ "$pfx_choice" -ge 1 ] && [ "$pfx_choice" -le "${#gh_accs[@]}" ]; then
                    target_user="${gh_accs[$((pfx_choice-1))]}@"
                else
                    echo -e "${RED}Pilihan tidak valid!${RESET}"; sleep 1; continue
                fi
                if [[ "$cur_orig" =~ github\.com ]]; then
                    local updated_url
                    updated_url=$(echo "$cur_orig" | sed -E "s#(https://)([^@]+@)?github\.com/#\\1${target_user}github.com/#")
                    run_as_user git remote set-url origin "$updated_url"
                    echo -e "${GREEN}✓ URL Remote Origin diubah menjadi:${RESET} $updated_url"
                else
                    echo -e "${RED}Remote origin bukan URL HTTPS GitHub!${RESET}"
                fi
                read -p "Tekan Enter untuk kembali..."
                ;;
            3)
                read -p "Nama remote baru (misal: upstream): " rem_name
                read -p "URL remote: " rem_url
                if [ -n "$rem_name" ] && [ -n "$rem_url" ]; then
                    run_as_user git remote add "$rem_name" "$rem_url"
                    echo -e "${GREEN}✓ Remote $rem_name berhasil ditambahkan!${RESET}"
                fi
                read -p "Tekan Enter untuk kembali..."
                ;;
            4)
                read -p "Masukkan nama remote yang ingin dihapus: " del_rem
                if [ -n "$del_rem" ]; then
                    run_as_user git remote remove "$del_rem"
                    echo -e "${GREEN}✓ Remote $del_rem dihapus!${RESET}"
                fi
                read -p "Tekan Enter untuk kembali..."
                ;;
            5)
                read -p "Nama remote yang ingin ditest [origin]: " test_rem
                [ -z "$test_rem" ] && test_rem="origin"
                echo -e "${YELLOW}Menghubungi $test_rem...${RESET}"
                run_as_user git ls-remote "$test_rem" HEAD
                read -p "Tekan Enter untuk kembali..."
                ;;
            0) break ;;
            *) echo -e "${RED}Pilihan tidak valid!${RESET}"; sleep 1 ;;
        esac
    done
}

function show_git_branch_menu() {
    if ! is_in_git_repo; then
        echo -e "${RED}Perintah ini hanya bisa dijalankan di dalam repository Git!${RESET}"
        read -p "Tekan Enter untuk kembali..."
        return
    fi
    while true; do
        show_git_header
        echo -e "${BOLD}${YELLOW}[ BRANCH MANAGER ]${RESET}\n"
        echo -e "  ${GREEN}1)${RESET} 🔀 Switch / Checkout Branch"
        echo -e "  ${GREEN}2)${RESET} 🌿 Buat Branch Baru & Checkout (git checkout -b)"
        echo -e "  ${RED}3)${RESET} 🗑️  Hapus Branch Lokal (git branch -d)"
        echo -e "  ${CYAN}4)${RESET} 📋 Lihat Semua Branch (Local & Remote)"
        echo -e "  ${RED}0)${RESET} 🔙 Kembali ke Menu Git"
        echo ""
        read -p "Pilihan [0-4]: " b_choice
        case $b_choice in
            1)
                if command -v fzf &>/dev/null; then
                    local chosen_branch
                    chosen_branch=$(run_as_user git branch --format="%(refname:short)" | fzf --prompt="Pilih Branch: " --height=40% --reverse)
                    if [ -n "$chosen_branch" ]; then
                        run_as_user git checkout "$chosen_branch"
                    fi
                else
                    echo "Daftar Branch:"
                    local branches=()
                    while IFS= read -r br; do
                        [ -n "$br" ] && branches+=("$br")
                    done < <(run_as_user git branch --format="%(refname:short)")
                    local idx=1
                    for br in "${branches[@]}"; do
                        echo "  $idx) $br"
                        ((idx++))
                    done
                    read -p "Pilih nomor branch: " br_num
                    if [[ "$br_num" =~ ^[0-9]+$ ]] && [ "$br_num" -ge 1 ] && [ "$br_num" -le "${#branches[@]}" ]; then
                        run_as_user git checkout "${branches[$((br_num-1))]}"
                    fi
                fi
                read -p "Tekan Enter untuk kembali..."
                ;;
            2)
                read -p "Masukkan nama branch baru: " new_br
                if [ -n "$new_br" ]; then
                    run_as_user git checkout -b "$new_br"
                fi
                read -p "Tekan Enter untuk kembali..."
                ;;
            3)
                read -p "Nama branch yang ingin dihapus: " del_br
                if [ -n "$del_br" ]; then
                    run_as_user git branch -d "$del_br"
                fi
                read -p "Tekan Enter untuk kembali..."
                ;;
            4)
                echo -e "\n${CYAN}--- SEMUA BRANCH ---${RESET}"
                run_as_user git branch -a
                echo ""
                read -p "Tekan Enter untuk kembali..."
                ;;
            0) break ;;
            *) echo -e "${RED}Pilihan tidak valid!${RESET}"; sleep 1 ;;
        esac
    done
}

function show_git_commit_push_menu() {
    if ! is_in_git_repo; then
        echo -e "${RED}Perintah ini hanya bisa dijalankan di dalam repository Git!${RESET}"
        read -p "Tekan Enter untuk kembali..."
        return
    fi
    while true; do
        show_git_header
        echo -e "${BOLD}${YELLOW}[ COMMIT & PUSH ]${RESET}\n"
        echo -e "  ${GREEN}1)${RESET} ⚡ Quick Commit (git add -A && git commit -m)"
        echo -e "  ${GREEN}2)${RESET} 📝 Commit Staged Only (git commit -m)"
        echo -e "  ${GREEN}3)${RESET} 🚀 Push Branch Saat Ini (git push)"
        echo -e "  ${GREEN}4)${RESET} 🛫 Push Branch Baru ke Origin (git push -u origin <branch>)"
        echo -e "  ${RED}5)${RESET} ⚠️  Force Push Aman (git push --force-with-lease)"
        echo -e "  ${RED}0)${RESET} 🔙 Kembali ke Menu Git"
        echo ""
        read -p "Pilihan [0-5]: " cp_choice
        case $cp_choice in
            1)
                read -p "Pesan commit: " msg
                if [ -n "$msg" ]; then
                    run_as_user git add -A
                    run_as_user git commit -m "$msg"
                    read -p "Ingin langsung push ke remote? (y/N): " do_push
                    if [[ "$do_push" =~ ^[Yy]$ ]]; then
                        run_as_user git push
                    fi
                fi
                read -p "Tekan Enter untuk kembali..."
                ;;
            2)
                read -p "Pesan commit: " msg
                if [ -n "$msg" ]; then
                    run_as_user git commit -m "$msg"
                fi
                read -p "Tekan Enter untuk kembali..."
                ;;
            3)
                run_as_user git push
                read -p "Tekan Enter untuk kembali..."
                ;;
            4)
                local cur_br
                cur_br=$(run_as_user git branch --show-current)
                echo -e "Pushing branch ${BOLD}${cur_br}${RESET} ke origin..."
                run_as_user git push -u origin "$cur_br"
                read -p "Tekan Enter untuk kembali..."
                ;;
            5)
                read -p "Yakin ingin menjalankan force push with lease? (y/N): " confirm_fp
                if [[ "$confirm_fp" =~ ^[Yy]$ ]]; then
                    run_as_user git push --force-with-lease
                fi
                read -p "Tekan Enter untuk kembali..."
                ;;
            0) break ;;
            *) echo -e "${RED}Pilihan tidak valid!${RESET}"; sleep 1 ;;
        esac
    done
}

function show_git_menu() {
    while true; do
        show_git_header
        echo -e "${BOLD}Pilih Modul Git & GitHub:${RESET}\n"
        echo -e "  ${CYAN}[1]${RESET} 🔄 ${BOLD}Pull & Sync${RESET} (Quick pull, rebase, fetch prune)"
        echo -e "  ${CYAN}[2]${RESET} 📝 ${BOLD}Working Tree & Changes${RESET} (Status, diff, stash, clean)"
        echo -e "  ${CYAN}[3]${RESET} 🚀 ${BOLD}Commit & Push${RESET} (Stage all, commit, push -u)"
        echo -e "  ${CYAN}[4]${RESET} 👤 ${BOLD}Switch Akun & Identitas${RESET} (Local Repo & Global Switch)"
        echo -e "  ${CYAN}[5]${RESET} 🌐 ${BOLD}Remote Manager${RESET} (Set-url, prefix user@, add/remove)"
        echo -e "  ${CYAN}[6]${RESET} 🌿 ${BOLD}Branch Manager${RESET} (Checkout fzf, create, delete)"
        echo -e "  ${CYAN}[7]${RESET} 📜 ${BOLD}Git Log / History${RESET} (Graph visual & commit terakhir)"
        echo -e "  ${RED}[0]${RESET} 🔙 ${BOLD}Kembali ke Menu Utama Acer${RESET}"
        echo ""
        read -p "Masukkan pilihan [0-7]: " g_main
        case $g_main in
            1) show_git_pull_menu ;;
            2) show_git_working_menu ;;
            3) show_git_commit_push_menu ;;
            4) show_git_switch_account_menu ;;
            5) show_git_remote_menu ;;
            6) show_git_branch_menu ;;
            7)
                echo -e "\n${CYAN}--- RIWAYAT COMMIT (GIT GRAPH) ---${RESET}"
                run_as_user git log --graph --oneline --decorate --color=always -n 15
                echo ""
                read -p "Tekan Enter untuk kembali..."
                ;;
            0) break ;;
            *) echo -e "${RED}Pilihan tidak valid!${RESET}"; sleep 1 ;;
        esac
    done
}

# ==========================================================
# 4B. NEXT.JS WEB GUI DASHBOARD MANAGER
# ==========================================================
ACER_GUI_PORT="${ACER_GUI_PORT:-3456}"
ACER_GUI_PID_FILE="/tmp/acer-gui.pid"
ACER_GUI_LOG_FILE="/tmp/acer-gui.log"

function find_bun_bin() {
    if command -v bun &>/dev/null; then
        command -v bun
    else
        local real_home
        real_home=$(get_real_home)
        if [ -x "$real_home/.bun/bin/bun" ]; then
            echo "$real_home/.bun/bin/bun"
        fi
    fi
}

function is_gui_port_open() {
    local port="$1"
    (echo >/dev/tcp/127.0.0.1/"$port") &>/dev/null
}

function start_web_gui() {
    local mode="${1:-start}"
    local open_browser="${2:-0}"
    local port="$ACER_GUI_PORT"
    local web_dir="$PROJECT_DIR/web"
    local url="http://localhost:${port}"

    if [ ! -d "$web_dir" ]; then
        echo -e "${RED}✗ Direktori Next.js tidak ditemukan di: $web_dir${RESET}"
        return 1
    fi

    local bun_bin
    bun_bin=$(find_bun_bin)
    if [ -z "$bun_bin" ]; then
        echo -e "${RED}✗ Runtime Bun tidak ditemukan! Pasang Bun terlebih dahulu (https://bun.sh).${RESET}"
        return 1
    fi

    if is_gui_port_open "$port"; then
        echo -e "${GREEN}✓ Acer Web GUI sudah aktif!${RESET}"
        echo -e "  ${CYAN}URL  :${RESET} ${BOLD}${url}${RESET}"
        echo -e "  ${CYAN}Log  :${RESET} ${ACER_GUI_LOG_FILE}"
        if [ "$open_browser" = "1" ] && command -v xdg-open &>/dev/null; then
            run_as_user xdg-open "$url" &>/dev/null &
        fi
        return 0
    fi

    if [ ! -d "$web_dir/node_modules" ]; then
        echo -e "${YELLOW}📦 Menginstal dependensi Web GUI dengan Bun...${RESET}"
        run_as_user bash -c "cd '$web_dir' && '$bun_bin' install" || return 1
    fi

    local next_subcmd="start"
    if [ "$mode" = "dev" ]; then
        next_subcmd="dev"
    elif [ ! -d "$web_dir/.next" ]; then
        echo -e "${YELLOW}🔨 Membangun Next.js production bundle pertama kali...${RESET}"
        run_as_user bash -c "cd '$web_dir' && '$bun_bin' run build" || return 1
    fi

    echo -e "${YELLOW}🚀 Menjalankan Acer Web GUI (Next.js + Bun) di port ${port}...${RESET}"
    run_as_user bash -c "cd '$web_dir' && PORT='$port' setsid '$bun_bin' --bun next '$next_subcmd' -p '$port' > '$ACER_GUI_LOG_FILE' 2>&1 < /dev/null & echo \$! > '$ACER_GUI_PID_FILE'"

    local ready=0
    for _ in $(seq 1 20); do
        if is_gui_port_open "$port"; then
            ready=1
            break
        fi
        sleep 0.5
    done

    if [ "$ready" -eq 1 ]; then
        echo -e "${GREEN}✓ Acer Web GUI berhasil dijalankan!${RESET}"
        echo -e "  ${CYAN}URL  :${RESET} ${BOLD}${url}${RESET}"
        echo -e "  ${CYAN}Mode :${RESET} ${next_subcmd} (Bun)"
        echo -e "  ${CYAN}Stop :${RESET} acer gui stop"
        if [ "$open_browser" = "1" ] && command -v xdg-open &>/dev/null; then
            run_as_user xdg-open "$url" &>/dev/null &
        fi
    else
        echo -e "${RED}✗ Server gagal siap dalam 10 detik. Cek log:${RESET} $ACER_GUI_LOG_FILE"
        tail -n 20 "$ACER_GUI_LOG_FILE" 2>/dev/null || true
        return 1
    fi
}

function stop_web_gui() {
    local stopped=0
    if [ -f "$ACER_GUI_PID_FILE" ]; then
        local pid
        pid=$(cat "$ACER_GUI_PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            stopped=1
        fi
        rm -f "$ACER_GUI_PID_FILE"
    fi
    if command -v pkill &>/dev/null && is_gui_port_open "$ACER_GUI_PORT"; then
        pkill -f "next.*${ACER_GUI_PORT}" 2>/dev/null || true
        stopped=1
    fi
    if [ "$stopped" -eq 1 ]; then
        echo -e "${GREEN}✓ Acer Web GUI dihentikan.${RESET}"
    else
        echo -e "${YELLOW}ℹ️  Acer Web GUI tidak sedang berjalan.${RESET}"
    fi
}

function status_web_gui() {
    local url="http://localhost:${ACER_GUI_PORT}"
    if is_gui_port_open "$ACER_GUI_PORT"; then
        local pid="unknown"
        [ -f "$ACER_GUI_PID_FILE" ] && pid=$(cat "$ACER_GUI_PID_FILE" 2>/dev/null)
        echo -e "${GREEN}● Acer Web GUI AKTIF${RESET} — ${BOLD}${url}${RESET} (PID: ${pid})"
    else
        echo -e "${YELLOW}○ Acer Web GUI TIDAK AKTIF${RESET} (Jalankan: ${GREEN}acer gui${RESET})"
    fi
}

function show_gui_menu() {
    while true; do
        show_header
        echo -e "${BOLD}${YELLOW}[ 🌐 WEB GUI DASHBOARD (NEXT.JS + BUN) ]${RESET}\n"
        status_web_gui
        echo -e "  ${CYAN}URL Lokal :${RESET} http://localhost:${ACER_GUI_PORT}"
        echo -e "  ${CYAN}Project   :${RESET} ${PROJECT_DIR}/web"
        echo -e "${CYAN}----------------------------------------------------${RESET}"
        echo -e "  ${GREEN}1)${RESET} 🚀 Start / Tampilkan Link Web GUI"
        echo -e "  ${GREEN}2)${RESET} 🌐 Start & Buka di Browser (xdg-open)"
        echo -e "  ${CYAN}3)${RESET} 🛠️  Start Mode Dev (Hot Reload)"
        echo -e "  ${RED}4)${RESET} 🛑 Stop Web GUI Server"
        echo -e "  ${BLUE}5)${RESET} 📜 Lihat Log Server"
        echo -e "  ${RED}0)${RESET} 🔙 Kembali ke Menu Utama"
        echo ""
        read -p "Masukkan pilihan [0-5]: " gui_choice
        case $gui_choice in
            1)
                start_web_gui "start" "0"
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            2)
                start_web_gui "start" "1"
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            3)
                start_web_gui "dev" "0"
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            4)
                stop_web_gui
                read -p "Tekan Enter untuk melanjutkan..."
                ;;
            5)
                echo -e "\n${CYAN}--- LOG SERVER ($ACER_GUI_LOG_FILE) ---${RESET}"
                tail -n 30 "$ACER_GUI_LOG_FILE" 2>/dev/null || echo "(Belum ada log)"
                echo ""
                read -p "Tekan Enter untuk kembali..."
                ;;
            0) break ;;
            *) echo -e "${RED}Pilihan tidak valid!${RESET}"; sleep 1 ;;
        esac
    done
}

# ==========================================================
# 5. CLI DIRECT ARGUMENT DISPATCHER
# ==========================================================
case "$1" in
    fan)
        if [ "$2" = "--help" ] || [ "$2" = "-h" ] || [ "$2" = "help" ]; then
            echo -e "${BOLD}Penggunaan: acer fan [subcommand]${RESET}"
            echo -e "  ${GREEN}acer fan${RESET}                                : Menu interaktif kipas & sensor"
            echo -e "  ${GREEN}acer fan auto [all|cpu|left|gpu|right]${RESET}  : Set mode Auto (kedua/kiri/kanan)"
            echo -e "  ${GREEN}acer fan set <0-100> [all|cpu|gpu]${RESET}      : Set kecepatan manual (kedua/kiri/kanan)"
            echo -e "  ${GREEN}acer fan sensor${RESET}                         : Konfigurasi sensor suhu kipas"
            echo -e "  ${GREEN}acer fan sensor <0|1|cpu|gpu> <sensor> [Average|Min|Max]${RESET}"
            exit 0
        fi
        check_sudo_for_hw "$@"
        case "$2" in
            auto)
                tgt="${3:-both}"
                apply_fan_command "$tgt" "auto"
                echo -e "${GREEN}✓ $(fan_target_label "$tgt") diatur ke mode AUTO!${RESET}"
                exit 0
                ;;
            set)
                spd="$3"
                tgt="${4:-both}"
                if [[ "$spd" =~ ^[0-9]+$ ]] && [ "$spd" -ge 0 ] && [ "$spd" -le 100 ]; then
                    apply_fan_command "$tgt" "manual" "$spd"
                    echo -e "${GREEN}✓ $(fan_target_label "$tgt") diatur ke ${spd}%!${RESET}"
                    exit 0
                else
                    echo -e "${RED}Kecepatan harus angka 0-100!${RESET}"
                    exit 1
                fi
                ;;
            sensor|sensors)
                if [ -n "$3" ] && [ -n "$4" ]; then
                    case "${3,,}" in
                        0|cpu|left|kiri) f_idx=0 ;;
                        1|gpu|right|kanan) f_idx=1 ;;
                        *) echo -e "${RED}Target fan tidak valid (gunakan 0/cpu atau 1/gpu)${RESET}"; exit 1 ;;
                    esac
                    s_name="$4"
                    algo="${5:-Average}"
                    if [ "$s_name" = "@default" ] || [ "$s_name" = "default" ]; then
                        nbfc sensors set -f "$f_idx" && nbfc restart
                    else
                        nbfc sensors set -f "$f_idx" -s "$s_name" -a "$algo" --force && nbfc restart
                    fi
                    echo -e "${GREEN}✓ Sensor Fan #${f_idx} diperbarui!${RESET}"
                else
                    show_fan_sensor_menu
                fi
                exit 0
                ;;
            left|kiri|cpu)
                show_fan_menu "cpu"
                exit 0
                ;;
            right|kanan|gpu)
                show_fan_menu "gpu"
                exit 0
                ;;
            *)
                show_fan_menu "both"
                exit 0
                ;;
        esac
        ;;
    rgb|keyboard)
        check_sudo_for_hw "$@"
        show_keyboard_menu
        exit 0
        ;;
    bat|battery)
        check_sudo_for_hw "$@"
        show_battery_menu
        exit 0
        ;;
    gpu)
        check_sudo_for_hw "$@"
        show_gpu_menu
        exit 0
        ;;
    gui|web)
        case "$2" in
            stop)
                stop_web_gui
                exit 0
                ;;
            status)
                status_web_gui
                exit 0
                ;;
            dev)
                start_web_gui "dev" "0"
                exit 0
                ;;
            logs)
                tail -n 40 "$ACER_GUI_LOG_FILE" 2>/dev/null || echo "Belum ada log GUI."
                exit 0
                ;;
            --open|open)
                start_web_gui "start" "1"
                exit 0
                ;;
            start|"")
                start_web_gui "start" "0"
                exit 0
                ;;
            *)
                show_gui_menu
                exit 0
                ;;
        esac
        ;;
    git)
        shift
        show_git_menu
        exit 0
        ;;
    switch|account)
        if [ -z "$2" ]; then
            show_git_switch_account_menu
            exit 0
        elif [ "$2" = "reset" ]; then
            reset_local_account
            exit 0
        else
            load_account_presets
            target_q="${2,,}"
            matched=0
            for entry in "${ACCOUNT_PRESETS[@]}"; do
                IFS='|' read -r p_alias p_gh p_name p_mail <<< "$entry"
                if [ "${p_alias,,}" = "$target_q" ] || [ "${p_gh,,}" = "$target_q" ]; then
                    apply_local_account "$p_gh" "$p_name" "$p_mail"
                    matched=1
                    break
                fi
            done
            if [ "$matched" -eq 0 ]; then
                echo -e "${RED}Preset akun '$2' tidak ditemukan di accounts.conf!${RESET}"
                echo -e "${YELLOW}Membuka menu Switch Akun...${RESET}"
                show_git_switch_account_menu
            fi
            exit 0
        fi
        ;;
    pull)
        if is_in_git_repo; then
            run_as_user git pull
        else
            echo -e "${RED}Bukan direktori repository Git!${RESET}"
        fi
        exit 0
        ;;
    status)
        if is_in_git_repo; then
            run_as_user git status
        else
            echo -e "${RED}Bukan direktori repository Git!${RESET}"
        fi
        exit 0
        ;;
    help|-h|--help)
        echo -e "${BOLD}Acer Control & Developer Suite CLI${RESET}"
        echo -e "Penggunaan:"
        echo -e "  ${GREEN}acer${RESET}                              : Buka Menu Interaktif Utama"
        echo -e "  ${GREEN}acer gui [--open|dev|status|stop]${RESET} : Jalankan / Kelola Web GUI Next.js (Link Dashboard)"
        echo -e "  ${GREEN}acer fan [auto|set|sensor]${RESET}        : Pengaturan Kipas (Both/Kiri/Kanan & Sensor Suhu)"
        echo -e "  ${GREEN}acer rgb${RESET}                          : Buka Pengaturan Keyboard RGB (Facer)"
        echo -e "  ${GREEN}acer bat${RESET}                          : Buka Pengaturan Batas Baterai (80% Cut-Off)"
        echo -e "  ${GREEN}acer gpu${RESET}                          : Buka Pengaturan Mode Grafis (Hybrid / iGPU / NVIDIA)"
        echo -e "  ${GREEN}acer git${RESET}                          : Buka Menu Git & GitHub Manager"
        echo -e "  ${GREEN}acer switch${RESET}                       : Buka Menu Ganti Akun (Lokal Repo & Global)"
        echo -e "  ${GREEN}acer switch <alias>${RESET}               : 1-Click LOKAL Switch sesuai ~/.config/acer/accounts.conf"
        echo -e "  ${GREEN}acer switch reset${RESET}                 : Reset override lokal kembali ke global"
        echo -e "  ${GREEN}acer pull${RESET}                         : Quick git pull di repo saat ini"
        echo -e "  ${GREEN}acer status${RESET}                       : Quick git status di repo saat ini"
        exit 0
        ;;
esac

# ==========================================================
# 6. MAIN INTERACTIVE ENTRY POINT
# ==========================================================
while true; do
    show_header
    echo -e "${BOLD}Silakan pilih fitur yang ingin diatur:${RESET}\n"
    echo -e "  ${CYAN}[1]${RESET} 🌬️  ${BOLD}Fan Control (Both / Kiri / Kanan & Sensor Suhu)${RESET}"
    echo -e "  ${CYAN}[2]${RESET} ⌨️  ${BOLD}Keyboard RGB (Pengaturan Lampu Keyboard)${RESET}"
    echo -e "  ${CYAN}[3]${RESET} 🔋 ${BOLD}Battery Care & Charge Limit (Batas Cas Baterai)${RESET}"
    echo -e "  ${CYAN}[4]${RESET} 🎮 ${BOLD}GPU Mode Switcher (Hybrid, iGPU AMD, NVIDIA RTX 3080)${RESET}"
    echo -e "  ${CYAN}[5]${RESET} 🌿 ${BOLD}Git & GitHub Manager (Sync, Working Tree, Switch Akun, Remote)${RESET}"
    echo -e "  ${CYAN}[6]${RESET} 🌐 ${BOLD}Web GUI Dashboard (Next.js — Link & Visual Monitor)${RESET}"
    echo -e "  ${RED}[0]${RESET} ❌ Keluar"
    echo ""
    read -p "Masukkan pilihan [0-6]: " main_choice

    case $main_choice in
        1)
            check_sudo_for_hw fan
            show_fan_menu
            ;;
        2)
            check_sudo_for_hw rgb
            show_keyboard_menu
            ;;
        3)
            check_sudo_for_hw bat
            show_battery_menu
            ;;
        4)
            check_sudo_for_hw gpu
            show_gpu_menu
            ;;
        5)
            show_git_menu
            ;;
        6)
            show_gui_menu
            ;;
        0)
            echo -e "\n${PURPLE}Sampai jumpa lagi, Sensei~! 🌸${RESET}\n"
            exit 0
            ;;
        *)
            echo -e "${RED}Pilihan tidak valid!${RESET}"
            sleep 1
            ;;
    esac
done
